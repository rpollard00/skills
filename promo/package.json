{
  "name": "skills-promo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "tsx scripts/sync-catalog.ts",
    "check": "tsx scripts/check.ts",
    "storyboard": "tsx scripts/storyboard.ts",
    "stills": "tsx scripts/stills.ts",
    "audio": "tsx scripts/audio.ts",
    "studio": "remotion studio --port=3123",
    "typecheck": "tsc --noEmit",
    "render": "npm run sync && npm run typecheck && npm run check && npm run audio && remotion render MakoPromo out/mako-promo.mp4"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.534",
    "@remotion/three": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
