{
  "name": "skill-explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "index": "tsx src/cli.ts index",
    "judge": "tsx src/cli.ts judge",
    "check": "tsx src/cli.ts check",
    "serve": "tsx src/server/main.ts",
    "build": "vite build",
    "dev": "vite",
    "start": "vite build && tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "effect": "4.0.2",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2"
  }
}
